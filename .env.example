# I'm Busy configuration. Copy to .env and fill in.
# Only ANTHROPIC_API_KEY is needed for the browser demo. Twilio + Telegram + a public URL unlock real calls.
# See docs/providers.md for step-by-step instructions for each credential.

# ---------------------------------------------------------------------------
# Anthropic (REQUIRED)
# ---------------------------------------------------------------------------
# API key. https://platform.claude.com > Settings > API keys > Create key.
ANTHROPIC_API_KEY=
# Model used during the call (latency-critical). Optional.
LLM_FAST_MODEL=claude-haiku-5-5
# Model used by the excuse compiler (quality-critical, runs once per excuse). Optional.
LLM_STRONG_MODEL=claude-sonnet-5-5
# Max retries on 429/5xx/connection errors for each LLM call. Optional.
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# App (optional, sensible defaults)
# ---------------------------------------------------------------------------
# development | production. Production refuses to start real-call mode without signature validation.
APP_ENV=development
LOG_LEVEL=INFO
# Public HTTPS origin that Twilio and Telegram reach (tunnel URL in local dev, no trailing slash).
# Required for real calls; unused by the browser demo. From `cloudflared tunnel --url http://localhost:8000` or ngrok.
PUBLIC_BASE_URL=
# SQLite file for users and call records.
DATABASE_PATH=./data/imbusy.sqlite3
# IANA zone used to read clock times in Telegram messages ("at 18:30"); the browser demo sends its own.
DEFAULT_TIMEZONE=Europe/Madrid
# Redis for short-lived call scripts. Leave empty to use an in-process store (fine for the demo and tests).
# docker compose sets this to redis://redis:6379/0.
REDIS_URL=

# ---------------------------------------------------------------------------
# Browser demo (optional)
# ---------------------------------------------------------------------------
# Serve the demo page and its WebSocket.
DEMO_ENABLED=true
# Demo sessions allowed per client IP per hour; protects the owner's Anthropic bill on a public deployment.
DEMO_MAX_SESSIONS_PER_HOUR=10

# ---------------------------------------------------------------------------
# Twilio (optional; required for real phone calls)
# ---------------------------------------------------------------------------
# Account SID (starts with AC). Twilio Console home page, "Account Info" panel.
TWILIO_ACCOUNT_SID=
# Auth token. Same panel; click "Show". Also used to validate X-Twilio-Signature on webhooks and the WebSocket handshake.
TWILIO_AUTH_TOKEN=
# Caller ID in E.164 (e.g. +14155550100). Phone Numbers > Manage > Active numbers. Must be a number you own on an upgraded account.
TWILIO_FROM_NUMBER=
# Validate X-Twilio-Signature on every Twilio request. Only disable for local debugging.
TWILIO_VALIDATE_SIGNATURES=true
# ConversationRelay TTS provider: Google | Amazon | ElevenLabs. Voices per provider live in src/imbusy/call/voices.py.
TWILIO_TTS_PROVIDER=Google
# Seconds the phone rings before Twilio gives up.
TWILIO_RING_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Telegram (optional; required for real phone calls)
# ---------------------------------------------------------------------------
# Bot token from @BotFather (/newbot). Looks like 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Random string you choose, 1-256 chars of A-Z a-z 0-9 _ -. Sent back by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Limits (optional)
# ---------------------------------------------------------------------------
# Real calls per verified user per rolling 24 h.
MAX_CALLS_PER_USER_PER_DAY=5
# Longest delay a user may ask for ("in 10 min"), in seconds.
MAX_CALL_DELAY_SECONDS=900
# Delay used when the message does not say when, in seconds.
DEFAULT_CALL_DELAY_SECONDS=20

# ---------------------------------------------------------------------------
# Safe word (optional; only used when real calls are configured)
# ---------------------------------------------------------------------------
# Seconds a location shared with the bot is kept before it is forgotten on its own (60 to 86400).
LOCATION_TTL_SECONDS=3600
# Hours a trusted-contact invitation link stays valid (1 to 168).
INVITE_TTL_HOURS=24
